# hop environment — copy to .env.local for local dev, or set these in the
# Claude Code cloud environment settings. Env access is LAZY (lib/env.ts reads
# process.env at call time), and every seam degrades to a clean no-op when its
# key is absent — so pages still render with nothing but the two vars below.

# ── Minimal loop: iterate on website content / aesthetics visually ──────────
# These two are all you need to see full-fidelity pages (photos + data) locally.
MOCK=1                              # swap in cash/awards/balances fixtures (1|true|yes)
UNSPLASH_ACCESS_KEY=                # destination photos; absent → solid/blur fallback
#                                     get one at https://unsplash.com/oauth/applications

# ── Everything below is production functionality, OFF by default ────────────
# Upstream engine sources (absent → that section is `degraded`, page still loads)
DUFFEL_API_KEY_LIVE=               # cash flights (Duffel)
DUFFEL_API_KEY_TEST=               # duffel_test_… — native checkout books against THIS only
SEATS_AERO_API_KEY=                # award availability (seats.aero)
AWARDWALLET_API_KEY=               # live balance link (AwardWallet)
AWARDWALLET_USER_ID=
AWARDWALLET_CONNECT_URL=           # hosted "Connect Users" URL from the AW business dashboard

# Persistence / identity (absent → withDb returns fallbacks, no crash)
DATABASE_URL=                      # Supabase Postgres (service-role path)
NEXT_PUBLIC_SITE_URL=              # canonical origin for absolute links / OG

# Identity — Auth0 (absent → auth layer skipped, signed-out surfaces only)
AUTH0_DOMAIN=                      # sentinel: middleware + lib/auth0.ts skip Auth0 when unset
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=                      # session cookie encryption (openssl rand -hex 32)
APP_BASE_URL=                      # e.g. http://localhost:3000

# Supabase (session refresh + service-role queries via utils/supabase/*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (absent → alerts stay in-app, cron skips delivery)
RESEND_API_KEY=
HOP_ALERT_EMAIL_FROM=
HOP_SUPPORT_EMAIL_FROM=
HOP_SUPPORT_INGEST_SECRET=         # guards POST /api/support-ingest; absent → rejects all

# AI concierge (/ask) — Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_SUMMARY_MODEL=          # cheaper model for conversation summaries

# Rate limiting (Upstash Redis; absent → limiter no-ops)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gated seams — need BOTH the flag AND the credentials (see lib/env.ts)
HOP_ENABLE_CHECKOUT=               # + DUFFEL_API_KEY_TEST → native cash checkout
HOP_ENABLE_GMAIL_HISTORY=          # + GOOGLE_OAUTH_* → Gmail travel-history import
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Valuation sync (ADR 0005; inert until the Cloudflare worker is deployed)
HOP_ENABLE_VALUATION_SYNC=
HOP_VALUATION_WORKER_URL=
HOP_VALUATION_SYNC_SECRET=

# Agentic memory flags (conversation memory / inferred facts / observed outcomes)
HOP_ENABLE_CONVO_MEMORY=
HOP_ENABLE_INFERRED_FACTS=
HOP_ENABLE_OBSERVED_OUTCOMES=

# Cron auth (Vercel Cron → /api/cron/*) + per-job kill switches
CRON_SECRET=
SEO_CRON_ENABLED=                  # gates /api/cron/revalidate-seo (defaults ON when unset)
STANDING_ORDERS_CRON_ENABLED=      # gates /api/cron/standing-orders (OFF until truthy)
