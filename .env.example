# hop environment — copy to .env.local for local dev, or set these in Vercel /
# the Claude Code cloud environment settings. Env access is LAZY (lib/env.ts
# reads process.env at call time), and every seam degrades to a clean no-op when
# its key is absent — pages still render with nothing but the two vars below.
#
# This file is the COMPLETE truth: every env var the app reads is listed here.
# Ops procedures (turning capabilities on/off in production): docs/ops-runbook.md.
# Platform-provided vars (NODE_ENV, VERCEL_URL, VERCEL_ENV, NEXT_RUNTIME, VITEST)
# are read in a few places but never set by hand — they are not listed.

# ── Minimal loop: iterate on website content / aesthetics visually ──────────
# These two are all you need to see full-fidelity pages (photos + data) locally.
MOCK=1                              # swap in cash/awards/balances fixtures (1|true|yes); NEVER set in prod
UNSPLASH_ACCESS_KEY=                # destination photos; absent → solid/blur fallback
#                                     get one at https://unsplash.com/oauth/applications
# For sign-in (/account, /admin): run scripts/setup-worktree-auth.sh — pulls from
# 1Password item "Hop Local Dev" (Private vault) when `op` is available.

# ── Auth + identity (Better Auth on Neon — lib/auth.ts, lib/db) ─────────────
DATABASE_URL=                      # Neon pooled connection string; absent → withDb falls back, auth + all persistence off
DATABASE_URL_UNPOOLED=             # unpooled Neon URL, preferred by drizzle-kit for DDL/migrations; optional
BETTER_AUTH_SECRET=                # session signing (openssl rand -hex 32); unset → derived from DATABASE_URL with a warning
AUTH_SECRET=                       # accepted alias for BETTER_AUTH_SECRET (checked second)
BETTER_AUTH_URL=                   # canonical origin for OAuth callbacks; falls back to NEXT_PUBLIC_SITE_URL, then hop.flights
GOOGLE_CLIENT_ID=                  # Google social login OAuth client; both absent → /login shows sign-in-unavailable
GOOGLE_CLIENT_SECRET=              # register {origin}/api/auth/callback/google as the redirect URI
GOOGLE_ID=                         # accepted alias for GOOGLE_CLIENT_ID (the names used in Vercel)
GOOGLE_SECRET=                     # accepted alias for GOOGLE_CLIENT_SECRET
HOP_ENABLE_EMAIL_PASSWORD_AUTH=    # email/password sign-in; needs RESEND_API_KEY too (verification email is load-bearing)
HOP_ENABLE_PASSKEY_AUTH=           # passkey/WebAuthn sign-in; flag-only, needs the `passkey` table in Neon
HOP_PASSKEY_RP_ID=                 # rpID override for local passkey testing (e.g. localhost); prod is locked to hop.flights
HOP_OWNER_EMAIL=                   # owner gate for /admin + recipient of ticket/lead/digest email; defaults to the founder inbox
APP_BASE_URL=                      # e.g. http://localhost:3000 — callback base for AwardWallet/Gmail OAuth + billing return URLs
NEXT_PUBLIC_SITE_URL=              # canonical origin for absolute links / OG / SEO (lib/seo.ts); defaults to https://hop.flights

# ── Upstream engine sources (absent → that section is `degraded`, page loads) ─
DUFFEL_API_KEY_LIVE=               # cash flight offers (lib/duffel.ts); absent → cash section degraded
DUFFEL_API_KEY_TEST=               # duffel_test_… — native checkout books against THIS only, never the live key
SEATS_AERO_API_KEY=                # award availability (lib/seatsaero.ts); absent → awards section degraded
AWARDWALLET_API_KEY=               # live balance link (lib/awardwallet.ts); absent → manual balances only
AWARDWALLET_USER_ID=               # AwardWallet business-account user id (pairs with the API key)
AWARDWALLET_CONNECT_URL=           # hosted "Connect Users" URL from the AW business dashboard; absent → connect CTA disabled

# ── AI concierge (/ask) — Vercel AI Gateway ──────────────────────────────────
AI_GATEWAY_API_KEY=                # absent → /ask degrades to its unavailable state; also gates memory/inference flags below
AI_GATEWAY_MODEL=                  # chat model override; defaults per call site (lib/ai-gateway.ts)
AI_GATEWAY_SUMMARY_MODEL=          # cheaper model for conversation summaries; falls back to AI_GATEWAY_MODEL

# ── Email (Resend — lib/email.ts) ────────────────────────────────────────────
RESEND_API_KEY=                    # absent → alert/support/digest email no-ops; alerts stay in-app, `delivered` stays false
HOP_ALERT_EMAIL_FROM=              # From identity for alerts; defaults to alerts@hop.flights — domain must be DKIM-verified in Resend
HOP_SUPPORT_EMAIL_FROM=            # From identity for support replies; defaults to support@hop.flights (also needs verification)
HOP_SUPPORT_INGEST_SECRET=         # bearer guarding POST /api/support-ingest (Cloudflare support@ Worker); absent → rejects ALL

# ── Feature flags — gated seams need BOTH the flag AND credentials (lib/env.ts)
HOP_ENABLE_CHECKOUT=               # + DUFFEL_API_KEY_TEST → native cash checkout; off → cash CTA deep-links to Kiwi
HOP_ENABLE_GMAIL_HISTORY=          # + both GOOGLE_OAUTH_* → Gmail travel-history import; off → "coming soon" state
GOOGLE_OAUTH_CLIENT_ID=            # Gmail-readonly OAuth client (DIFFERENT from the sign-in client above)
GOOGLE_OAUTH_CLIENT_SECRET=        # register {APP_BASE_URL}/auth/gmail/callback as the redirect URI
HOP_ENABLE_VALUATION_SYNC=         # + worker URL + secret → live cpp valuation sync (ADR 0005); inert until worker deployed
HOP_VALUATION_WORKER_URL=          # deployed cloudflare/valuations-worker base URL, no trailing slash
HOP_VALUATION_SYNC_SECRET=         # shared bearer between Vercel and the Worker (same value both sides)
HOP_ENABLE_SELF_IMPROVE=           # self-improvement loop (ADR 0007): degradation telemetry + daily health sentinel; flag-only
LINEAR_API_KEY=                    # sentinel's issue-filing channel; absent → detect-and-record only, P1s email the owner
LINEAR_TEAM_ID=                    # the one team issues land in (blast radius of the key); key never logged
HOP_ENABLE_CONVO_MEMORY=           # rolling concierge conversation summaries; also needs AI_GATEWAY_API_KEY
HOP_ENABLE_INFERRED_FACTS=         # "hop noticed…" pending suggestions; also needs AI_GATEWAY_API_KEY; never auto-applied
HOP_ENABLE_OBSERVED_OUTCOMES=      # "hop learned from what you do"; flag-only (deterministic aggregator, no LLM)

# ── Billing (Stripe — all four required before isBillingEnabled() is true) ───
HOP_ENABLE_BILLING=                # master flag; off → /account hides billing, checkout/webhook routes refuse softly
STRIPE_SECRET_KEY=                 # checkout-session creation; absent → billing stays off even with the flag set
STRIPE_PUBLISHABLE_KEY=            # client-side key (safe to expose); used by the checkout surface
STRIPE_WEBHOOK_SECRET=             # signature check on /api/webhooks/stripe — tier writes ONLY happen on signed events
STRIPE_PRICE_ID_PRO_MONTHLY=       # the price being sold; required for the billing gate
STRIPE_PRICE_ID_PRO_YEARLY=        # optional yearly price
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=  # public alias, wins over STRIPE_PRICE_ID_PRO_MONTHLY when set
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=   # public alias, wins over STRIPE_PRICE_ID_PRO_YEARLY when set

# ── Cron (Vercel Cron → /api/cron/* — schedules in vercel.json) ──────────────
CRON_SECRET=                       # bearer Vercel sends to every cron route; UNSET → routes 401 in prod, open in dev
STANDING_ORDERS_CRON_ENABLED=      # gates /api/cron/standing-orders (alerts runner); OFF until truthy
SEO_CRON_ENABLED=                  # gates /api/cron/revalidate-seo; defaults ON when unset

# ── Observability + rate limiting ─────────────────────────────────────────────
POSTHOG_KEY=                       # server-side PostHog LLM tracing (instrumentation.ts); absent → falls back to hop's hardcoded write-only token
POSTHOG_HOST=                      # PostHog host override; defaults to https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=           # client posthog-js funnel events (lib/posthog-client.ts, inlined at BUILD time); also accepted fallback for POSTHOG_KEY. Absent → client analytics is a silent no-op
NEXT_PUBLIC_POSTHOG_HOST=          # client api_host override (inlined at build time); defaults to https://us.i.posthog.com. Prod: the managed reverse proxy https://elephant.hop.flights (ad-blocker-resistant ingest; ui_host stays pinned to us.posthog.com in code)
NEXT_PUBLIC_VERCEL_HOP_POSTHOG_PROJECT_TOKEN=  # Vercel-integration-provided fallback token
NEXT_PUBLIC_VERCEL_HOP_POSTHOG_HOST=           # Vercel-integration-provided fallback host
UPSTASH_REDIS_REST_URL=            # TTL cache backend (lib/cache.ts); absent → transparent in-memory fallback
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=                   # accepted alias pair for the Upstash vars (Vercel KV naming)
KV_REST_API_TOKEN=

# ── Affiliates ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CJ_AFFILIATE_TAG=      # Commission Junction / Bankrate tag (lib/card-affiliates.ts); absent → untagged links
