{
  "name": "hop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev",
    "dev:mock": "MOCK=1 next dev",
    "build": "node scripts/db-migrate.mjs && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:check-migrations": "node scripts/check-migration-sequence.mjs",
    "verify:desk": "node scripts/verify-desk-run.mjs",
    "start": "next start",
    "lint": "eslint --cache --cache-location .next/cache/eslint/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run db:check-migrations && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@ai-sdk/otel": "1.0.4",
    "@ai-sdk/react": "^4.0.5",
    "@anthropic-ai/sdk": "^0.106.0",
    "@astryxdesign/core": "^0.1.5",
    "@better-auth/passkey": "^1.6.23",
    "@duffel/api": "^4.27.1",
    "@duffel/components": "^3.17.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@neondatabase/serverless": "^1.1.0",
    "@next/third-parties": "^16.3.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@phosphor-icons/react": "^2.1.10",
    "@posthog/ai": "^8.9.0",
    "@stylexjs/stylex": "^0.19.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.4",
    "better-auth": "^1.6.23",
    "botid": "^1.5.11",
    "drizzle-orm": "^0.45.2",
    "flag-icons": "^7.5.0",
    "mcp-handler": "^1.1.0",
    "next": "16.2.9",
    "posthog-js": "^1.448.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.1.2",
    "streamdown": "^2.5.0",
    "stripe": "^22.3.0",
    "svix": "^1.96.1",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
